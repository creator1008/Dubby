{
	email {$ACME_EMAIL}
	# Chrome caches Alt-Svc h3 for weeks. QUIC/UDP to Lightsail often
	# fails as net::ERR_FAILED with no ACAO — looks like a CORS error.
	servers {
		protocols h1 h2
	}
}

{$DUBBY_API_DOMAIN} {
	encode gzip
	header -Alt-Svc

	# Uploads go straight to R2 via presigned URLs, so bodies here stay small.
	request_body {
		max_size 10MB
	}

	# Do NOT set Access-Control-* here — FastAPI CORSMiddleware already does.
	# Duplicate ACAO values are rejected by browsers.

	reverse_proxy dubby-api:8000 {
		health_uri /healthz
		health_interval 30s
	}
}
