# Public site URL used for OAuth/email redirects (never localhost).
NEXT_PUBLIC_SITE_URL=https://dubbyai.com

# Real FastAPI origin (required). Local pipeline mode is disabled.
# NEXT_PUBLIC_LOCAL_PIPELINE=false
NEXT_PUBLIC_API_ORIGIN=https://api.dubbyai.com
# Leave empty / false — do not use local-step12 for production Pages.
# NEXT_PUBLIC_LOCAL_PIPELINE=false
# NEXT_PUBLIC_LOCAL_PIPELINE_ORIGIN=

# Supabase publishable/anon key only — never put service-role or secret keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_REVENUECAT_ANDROID_API_KEY=
NEXT_PUBLIC_REVENUECAT_IOS_API_KEY=

# Provider keys used by api/app/local_step12.py and the FastAPI worker
PIPELINE_MODE=auto
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
# FFMPEG_PATH=
